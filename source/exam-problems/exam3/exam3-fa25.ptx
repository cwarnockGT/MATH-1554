                    A =  \framebox{$\phantom{$\begin{bmatrix} a \amp a \amp a \amp a \amp a \\ b \\ c \\ d \\ e \\f  \end{bmatrix}$}$ }
                </md>
                
            </p>
        </statement>
        <answer>
            <p>
                <md>
                    A = \begin{bmatrix} 17 \amp -6 \\ 45 \amp -16 \end{bmatrix}

