        <problem>


        <statement>
            <p>
                (3 points) Suppose <m>A</m> is a diagonalizable matrix with <m>A = PDP^{-1}</m> where 

                <md>
                    A = \begin{bmatrix} -2 \amp 4 \\ a \amp 8 \end{bmatrix},P = \begin{bmatrix} 1 \amp 2 \\ 1 \amp b \end{bmatrix},D = \begin{bmatrix} c \amp 0 \\ 0 \amp 4 \end{bmatrix}
                </md>
                
                Find <m>a, b, </m> and <m>c</m>.
            <md>
                a = \framebox{$\phantom{$\begin{bmatrix} a \amp a \\ b  \end{bmatrix}$}$ } \text{    } b = \framebox{$\phantom{$\begin{bmatrix} a \amp a \\ b  \end{bmatrix}$}$ } \text{    } c = \framebox{$\phantom{$\begin{bmatrix} a \amp a \\ b  \end{bmatrix}$}$ } 
            </md>
            
            
           </p> 
        </statement>

        <answer>
            <p>
                <md>
                    a = -6
                </md>
                <md>
                    b = 3
                </md>
                <md>
                    c = 2
                </md> 
            </p>
        </answer>
        <solution>
            <p>
                Solution text
            </p>
        </solution>
    </problem>




